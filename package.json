{
	"name": "@involvex/bun-sweep",
	"version": "0.0.1",
	"private": true,
	"author": "involvex",
	"repository": {
		"type": "git",
		"url": "https://github.com/involvex/bun-sweep.git"
	},
	"bin": {
		"bun-sweep": "src/index.ts"
	},
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun",
		"dev": "bun src/index.ts",
		"typecheck": "bun check",
		"prebuild": "bun run format && bun run lint --fix && bun run typecheck",
		"lint": "bun lint src",
		"format": "bun fmt",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@involvex/del-cli": "^7.0.1",
		"has-flag": "^5.0.1"
	},
	"devDependencies": {
		"@involvex/prettier-config": "^0.0.6",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"prettier": "@involvex/prettier-config"
}
